    {
      "parameters": {
        "promptType": "define",
        "text": "=Classify the following user message into exactly one category:\n\n- COST: questions about price, budget, dollar amounts, estimates, $/SF, \n  how much something costs, financial tracking, over/under budget, \n  Uniformat clusters (substructure, shell, interiors, services, sitework)\n- CARBON: questions about CO2, kgCO2e, emissions, embodied carbon, \n  energy consumption, kWh, water usage, sustainability, STV, green performance\n- SCHEDULE: questions about timeline, sequencing, phases, duration, \n  when something starts or ends, construction tasks, installation order\n- BIM: questions about building elements, quantities, levels, zones, \n  families, categories, takt, ALICE mapping\n- MATERIAL: questions about material alternatives, substitutions, \n  comparing materials, what if we used X instead of Y\n\nReply with only the category word in capitals. Nothing else. No explanation.\n\nMessage: {{ $json.message }}",
        "options": {}
      },
