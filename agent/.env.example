# Concho agent: every variable the workflows and scripts read (roadmap P6.2, P6.3, P6.7).
# Copy to .env (git-ignored) and fill in. Never commit real values.
# The deployment bundle (docker-compose, Postgres, bot) adds its own variables in P6.6.

# --- project (prompt placeholders; else read from project.* in project_config.json) --------
# Used by scripts/render_agent.py at import time. Leave empty to take them from the config.
CONCHO_PROJECT_NAME=
CONCHO_LOCATION=
CONCHO_COMPLETION_DATE=
CONCHO_TEAM=

# --- models: the one place to change them (default gpt-4o-mini everywhere) -----------------
CONCHO_MODEL_ROUTER=gpt-4o-mini
CONCHO_MODEL_SUBAGENT=gpt-4o-mini
# Text-to-speech model for voice replies (reserved; no node uses it in this version).
CONCHO_MODEL_TTS=gpt-4o-mini-tts

# --- data API (concho-api serve) -----------------------------------------------------------
# Base URL the n8n tools call, no trailing slash, e.g. http://data-api:8000 inside docker.
CONCHO_API_URL=
# Bearer token of the data API (same value the API runs with). Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
CONCHO_API_TOKEN=

# --- webhook: the Discord bot (or the eval) POSTs to /webhook/<CONCHO_WEBHOOK_PATH> ---------
# Random string, at least 24 letters/digits/-/_ (secret part of the URL).
CONCHO_WEBHOOK_PATH=
# Value of the header X-Concho-Token the caller must send (n8n header-auth credential).
CONCHO_WEBHOOK_TOKEN=

# --- OpenAI (n8n credential "Concho OpenAI", created by the import script) -----------------
OPENAI_API_KEY=

# --- Discord (n8n credential "Concho Discord bot" and the reply / debug nodes) -------------
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Debug channel for the error workflow (readable details; users get a short message instead).
DISCORD_CHANNEL_ID_DEBUG=

# --- n8n -----------------------------------------------------------------------------------
# The workflows read the variables above with $env in expressions.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
