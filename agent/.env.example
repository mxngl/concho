# Concho agent: every variable the workflows and scripts read (roadmap P6.2, P6.3, P6.7).
# Copy to agent/.env (git-ignored; docker compose and scripts/import_workflows.sh read it) and
# fill in. Never commit real values. Secrets are empty here on purpose; the models and
# N8N_BLOCK_ENV_ACCESS_IN_NODE keep their defaults.
# Values with spaces or $ must be quoted (the import script sources this file).

# --- project (prompt placeholders; else read from project.* in project_config.json) --------
# Used by scripts/render_agent.py at import time. Leave empty to take them from the config.
CONCHO_PROJECT_NAME=
CONCHO_LOCATION=
CONCHO_COMPLETION_DATE=
CONCHO_TEAM=

# --- models: the one place to change them (default gpt-4o-mini everywhere) -----------------
CONCHO_MODEL_ROUTER=gpt-4o-mini
CONCHO_MODEL_SUBAGENT=gpt-4o-mini
# Text-to-speech model for voice replies (reserved; no node uses it in this version).
CONCHO_MODEL_TTS=gpt-4o-mini-tts

# --- data API (concho-api serve) -----------------------------------------------------------
# Base URL the n8n tools call, no trailing slash. Inside the compose bundle: http://data-api:8000
CONCHO_API_URL=http://data-api:8000
# Bearer token of the data API (same value the API runs with). Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
CONCHO_API_TOKEN=

# Team repo (folder with results/index.json) the data API serves, read-only. A path relative
# to agent/ or absolute, e.g. ../../my-team-repo
CONCHO_TEAM_REPO=

# --- webhook: the Discord bot (or the eval) POSTs to /webhook/<CONCHO_WEBHOOK_PATH> ---------
# Random string, at least 24 letters/digits/-/_ (secret part of the URL).
CONCHO_WEBHOOK_PATH=
# Value of the header X-Concho-Token the caller must send (n8n header-auth credential).
CONCHO_WEBHOOK_TOKEN=

# --- OpenAI (n8n credential concho-openai, created by scripts/import_workflows.sh) ---------
OPENAI_API_KEY=

# --- Discord (n8n credential concho-discord, the reply / debug nodes and the bot) ----------
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Channel(s) the bot listens in, comma separated (threads under them too); @mentions work anywhere.
DISCORD_CHANNEL_ID_ASK=
# Debug channel for the error workflow (readable details; users get a short message instead).
DISCORD_CHANNEL_ID_DEBUG=

# --- n8n -----------------------------------------------------------------------------------
# The workflows read the variables above with $env in expressions.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# Image tag: pin the version you tested (e.g. 1.x.y); "latest" follows n8n releases.
N8N_VERSION=latest
# Encrypts the credentials in the n8n database; losing it loses them. Generate:
#   python -c "import secrets; print(secrets.token_hex(32))"
N8N_ENCRYPTION_KEY=
# 127.0.0.1 = n8n's UI/webhook port only on this machine. Do not set 0.0.0.0 without TLS in front.
N8N_BIND_ADDRESS=127.0.0.1
N8N_WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=UTC

# --- Postgres (n8n's own data and the conversation memory, P6.4) -------------------------------
POSTGRES_USER=concho
POSTGRES_PASSWORD=
POSTGRES_DB=concho
# n8n credential concho-postgres (created by the import script) uses the three values above.
# Memory: last 6 messages per user and channel; older than this many days are deleted daily.
CONCHO_MEMORY_RETENTION_DAYS=30

# --- evaluation (scripts/run_eval.py, P6.8) ----------------------------------------------------
# Where the eval posts: the n8n webhook, from the host. Token = CONCHO_WEBHOOK_TOKEN above.
CONCHO_EVAL_WEBHOOK_URL=
