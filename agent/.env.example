# Concho agent: every variable the workflows, scripts and the docker-compose bundle read
# (roadmap P6.2, P6.3, P6.4, P6.6, P6.7). Copy to .env in the repo root (git-ignored) and fill
# in. Never commit real values: secrets stay empty here. docs/agent-deployment.md says which
# variable is needed for which step.

# --- project (prompt placeholders; else read from project.* in project_config.json) --------
# Used by scripts/render_agent.py at import time. Leave empty to take them from the config.
CONCHO_PROJECT_NAME=
CONCHO_LOCATION=
CONCHO_COMPLETION_DATE=
CONCHO_TEAM=
# The team's project_config.json (path on this machine); used by scripts/import_workflows.sh.
CONCHO_PROJECT_CONFIG=

# --- models: the one place to change them (default gpt-4o-mini everywhere) -----------------
CONCHO_MODEL_ROUTER=gpt-4o-mini
CONCHO_MODEL_SUBAGENT=gpt-4o-mini
# Text-to-speech model for voice replies (reserved; no node uses it in this version).
CONCHO_MODEL_TTS=gpt-4o-mini-tts

# --- memory (P6.4): the last N messages per user and channel, kept in Postgres ---------------
# Window sent to the router and the subagents, and how long messages are kept.
CONCHO_MEMORY_MESSAGES=6
CONCHO_MEMORY_DAYS=30

# --- data API (concho-api serve) -----------------------------------------------------------
# Base URL the n8n tools call, no trailing slash. docker-compose sets http://data-api:8000 for
# n8n itself; set it here only when n8n runs outside docker (e.g. http://127.0.0.1:8000).
CONCHO_API_URL=
# Bearer token of the data API (same value the API runs with). Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
CONCHO_API_TOKEN=
# The team repo folder with results/ (and exports/), mounted read-only into the data-api container.
CONCHO_DATA_REPO=

# --- webhook: the Discord bot (or the eval) POSTs to /webhook/<CONCHO_WEBHOOK_PATH> ---------
# Random string, at least 24 letters/digits/-/_ (secret part of the URL). The production URL is
# exactly /webhook/<this value>: the Webhook node of concho.json has a fixed webhookId for that.
CONCHO_WEBHOOK_PATH=
# Value of the header X-Concho-Token the caller must send (n8n header-auth credential).
CONCHO_WEBHOOK_TOKEN=

# --- OpenAI (n8n credential "Concho OpenAI", created by the import script) -----------------
OPENAI_API_KEY=

# --- Discord (n8n credential "Concho Discord bot" and the reply / debug nodes) -------------
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Channel(s) the bot answers in, comma separated (a thread of such a channel counts too).
DISCORD_CHANNEL_ID_ASK=
# Debug channel for the error workflow (readable details; users get a short message instead).
DISCORD_CHANNEL_ID_DEBUG=

# --- n8n -----------------------------------------------------------------------------------
# The workflows read the variables above with $env in expressions.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# Image tag of n8n (the version the workflow was tested on).
N8N_VERSION=2.43.8
# Port of the n8n editor on this machine (published on 127.0.0.1 only).
N8N_PORT=5678
# Encrypts the credentials n8n stores. Generate once and keep it: python -c "import secrets; print(secrets.token_hex(32))"
N8N_ENCRYPTION_KEY=
# Public base URL n8n shows for webhooks (with trailing slash); the bot uses the internal one.
N8N_WEBHOOK_BASE_URL=http://localhost:5678/
GENERIC_TIMEZONE=UTC

# --- Postgres (n8n's own database and the chat memory of P6.4) ------------------------------
POSTGRES_USER=concho
POSTGRES_PASSWORD=
POSTGRES_DB=concho
