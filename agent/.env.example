# Concho agent: every variable the workflows, scripts and the compose bundle read (roadmap
# P6.2, P6.3, P6.6, P6.7, P6.8). Copy to agent/.env (git-ignored) and fill in. Never commit real
# values: secrets stay empty here. Quote a value that contains spaces or '#'.
#
#   cp agent/.env.example agent/.env
#   docker compose -f agent/docker-compose.yml --env-file agent/.env up -d --build
#   scripts/import_workflows.sh

# --- project (prompt placeholders; else read from project.* in project_config.json) --------
# Used by scripts/render_agent.py at import time. Leave empty to take them from the config
# (scripts/import_workflows.sh --config path/to/project_config.json).
CONCHO_PROJECT_NAME=
CONCHO_LOCATION=
CONCHO_COMPLETION_DATE=
CONCHO_TEAM=

# --- models: the one place to change them (default gpt-4o-mini everywhere) -----------------
# A change needs a restart of n8n only (docker compose restart n8n), no re-import.
CONCHO_MODEL_ROUTER=gpt-4o-mini
CONCHO_MODEL_SUBAGENT=gpt-4o-mini
# Text-to-speech model for voice replies (reserved; no node uses it in this version).
CONCHO_MODEL_TTS=gpt-4o-mini-tts

# --- data API (concho-api serve) -----------------------------------------------------------
# Base URL the n8n tools call, no trailing slash. The compose file defaults to
# http://data-api:8000 (the container on the internal network); leave empty there.
CONCHO_API_URL=
# Bearer token of the data API (the API and n8n use the same value).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
CONCHO_API_TOKEN=
# Folder of the team repo (with results/index.json) the data API serves, read-only. A path on
# the Docker host, e.g. /home/me/island-team-repo.
CONCHO_TEAM_REPO=

# --- webhook: the Discord bot (or the eval) POSTs to /webhook/<CONCHO_WEBHOOK_PATH> ---------
# Random string, at least 24 letters/digits/-/_ (secret part of the URL).
CONCHO_WEBHOOK_PATH=
# Value of the header X-Concho-Token the caller must send (n8n header-auth credential).
CONCHO_WEBHOOK_TOKEN=

# --- OpenAI (n8n credential "Concho OpenAI", created by the import script) -----------------
OPENAI_API_KEY=

# --- Discord (bot, n8n credential "Concho Discord bot", reply and debug nodes) -------------
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Channel(s) the bot listens in, comma separated (threads of these channels count too).
DISCORD_CHANNEL_ID_ASK=
# Debug channel for the error workflow (readable details; users get a short message instead).
DISCORD_CHANNEL_ID_DEBUG=

# --- chat memory (P6.4) and Postgres -------------------------------------------------------
# One Postgres for n8n and the chat memory table (agent/memory.sql). Credentials are created
# from these values; the password is also the n8n database password.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=n8n
# Messages older than this many days are deleted (daily, service memory-maintenance).
CONCHO_MEMORY_RETENTION_DAYS=30

# --- n8n -----------------------------------------------------------------------------------
# The n8n release the workflows were imported and tested on (e.g. 1.x.y); no default on purpose.
N8N_VERSION=
# Encrypts the credentials n8n stores. Keep it: without it the credentials cannot be read.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
N8N_ENCRYPTION_KEY=
# Editor and webhook port, published on 127.0.0.1 only.
N8N_PORT=5678
GENERIC_TIMEZONE=UTC
# The workflows read the variables above with $env in expressions.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# --- evaluation (scripts/run_eval.py, P6.8) ------------------------------------------------
# Full webhook URL the eval posts to. Empty = http://127.0.0.1:$N8N_PORT/webhook/$CONCHO_WEBHOOK_PATH
CONCHO_EVAL_URL=
