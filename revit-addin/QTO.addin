  <AddIn Type="Command">
    <Text>Push 4D Build Code</Text>
    <Description>Pushes build_code from src\Planning_engine\Fuzor_Mapper\outputs\Revit_4D_Build_Code_Map.csv into the 4D_Build_Code parameter.</Description>
    <Assembly>QTO.dll</Assembly>
    <FullClassName>QTO.Push_TaskName_To_Revit</FullClassName>
    <ClientId>13C7B638-24A3-4CDE-9C31-5B1D0A9C95E1</ClientId>
    <VendorId>QTO</VendorId>
    <VendorDescription>QTO 4D Build Code Push</VendorDescription>
  </AddIn>
  <AddIn Type="Command">
    <Text>Push Manufacton Parameters</Text>
    <Description>Pushes assembly_id, catalog_id, kit_id, production order ID, and item name from src\Planning_engine\Prefab_BIM_Mapper\outputs into the Prefab_Assembly_ID, Prefab_Catalog_ID, Prefab_Kit_ID, Prefab_order_ID, and Prefab_Item_Name parameters.</Description>
    <Assembly>QTO.dll</Assembly>
    <FullClassName>QTO.Push_Manufacton_Parameters_To_Revit</FullClassName>
    <ClientId>29F2E1BC-1F65-4A3C-8D3A-7D2B05DB4F1D</ClientId>
    <VendorId>QTO</VendorId>
    <VendorDescription>QTO Manufacton Parameter Push</VendorDescription>
  </AddIn>
