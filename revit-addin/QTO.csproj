<Project Sdk="Microsoft.NET.Sdk">

  <!--
    One build per Revit version, selected by the configuration:
      Debug R25 / Release R25  -> Revit 2025
      Debug R26 / Release R26  -> Revit 2026 (also the plain Debug / Release default)
    Output: bin\<Configuration>\QTO.dll
    The Revit API comes from the Nice3point reference packages (compile-time only, not copied to
    the output), so the add-in builds without Revit installed.
  -->
  <PropertyGroup>
    <Configurations>Debug R25;Debug R26;Release R25;Release R26</Configurations>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>

  <PropertyGroup Condition="$(Configuration.EndsWith('R25'))">
    <RevitVersion>2025</RevitVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RevitVersion)' == ''">
    <RevitVersion>2026</RevitVersion>
  </PropertyGroup>

  <!-- Pinned reference package versions (latest of each Revit year at the time of P4.1). -->
  <PropertyGroup>
    <RevitApiPackageVersion Condition="'$(RevitVersion)' == '2025'">2025.4.60</RevitApiPackageVersion>
    <RevitApiPackageVersion Condition="'$(RevitVersion)' == '2026'">2026.4.10</RevitApiPackageVersion>
  </PropertyGroup>

  <PropertyGroup Condition="$(Configuration.StartsWith('Release'))">
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- Allows building the Windows target on Linux/macOS (CI, local checks). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>QTO</AssemblyName>
    <RootNamespace>QTO</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF (Microsoft.Win32.OpenFolderDialog) for choosing the export folder; Revit ships it. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitApiPackageVersion)" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitApiPackageVersion)" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
